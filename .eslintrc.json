{
  "parser": "@typescript-eslint/parser",
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-console": ["error", { "allow": ["error","warn"] }]
  },
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    },
    "project": "./tsconfig.json"
  }
}
